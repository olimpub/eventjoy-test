{
  "name": "eventjoy-app",
  "version": "0.0.1",
  "description": "EventJoy Application - Complex event management with modular games.",
  "productName": "EventJoy App",
  "author": "EventJoy Team",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:android": "quasar build -m capacitor -T android",
    "build:ios": "quasar build -m capacitor -T ios",
    "lint": "eslint --ext .js,.ts,.vue ./src",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss,md}\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "libphonenumber-js": "^1.13.8",
    "pinia": "^2.1.7",
    "quasar": "^2.12.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vue3-google-login": "^2.1.4"
  },
  "devDependencies": {
    "@quasar/app-vite": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^18.11.18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.45.0",
    "postcss": "^8.5.14",
    "prettier": "^3.0.0",
    "sass": "1.32.12",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": "^18 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
